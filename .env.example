# Copy to .env and fill in your own values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=

# Auth
JWT_SECRET=
SESSION_SECRET=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# AI and translation
OPENAI_API_KEY=
GOOGLE_TRANSLATE_PROJECT_ID=
